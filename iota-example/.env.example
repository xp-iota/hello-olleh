# iota-example 内核配置模板。复制为 .env（该文件已被 git 忽略）后填入真实值。
#
# 注意：shell 里已 export 的同名变量优先级高于本文件 —— load_project_env 只填空缺，
# 不覆盖已有 env。若发现跑起来用的是别的端点，先 `unset` 掉 shell 里的那几个。

# 内核选择：hermes_direct（默认，OpenAI 兼容，同进程直调）| claude（Anthropic 兼容）
IOTA_KERNEL=hermes_direct

# —— hermes_direct：OpenAI 兼容端点（需安装 extra: hermes）——
# base_url 未带 /v1 时工程会自动补上。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=fuyao-coding

# —— claude：Anthropic 兼容端点（需安装 extra: real，且 claude CLI 在 PATH 上）——
# LLM_VENDOR=minimax              # 或 fuyao
# LLM_BASE_URL=https://api.minimaxi.com/anthropic
# LLM_MODEL=MiniMax-M3
