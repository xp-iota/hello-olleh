{
  "name": "dsh-lab",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "一文一工程的 dsh/cordis 示例集：examples/ 下 22 个完全独立的示例（cordis 6 + dsh 16），各自带完整装配、README 主题文章与 Node/Bun 双运行时脚本。根层只保留运行时工具（调度/状态/校验/shim 契约）。",
  "engines": {
    "node": ">=22.18",
    "bun": ">=1.4.4",
    "pnpm": ">=11"
  },
  "scripts": {
    "//examples": "每个示例完全独立：example:<name> 代跑该示例的 start（Node），:bun 变体走示例自带调度器。",
    "//verify": "遍历 examples/：每示例 typecheck + start（Node）+ start:bun（Bun），末行 RUNTIMES_VERIFY_OK runtimes=2 checks=N。缺 key 的示例按明确失败计入报告。",
    "example:cordis-events-demo": "pnpm --dir examples/03-cordis-events-demo run start",
    "example:cordis-events-demo:bun": "pnpm --dir examples/03-cordis-events-demo run start:bun",
    "example:cordis-fiber-demo": "pnpm --dir examples/02-cordis-fiber-demo run start",
    "example:cordis-fiber-demo:bun": "pnpm --dir examples/02-cordis-fiber-demo run start:bun",
    "example:cordis-hmr-demo": "pnpm --dir examples/06-cordis-hmr-demo run start",
    "example:cordis-hmr-demo:bun": "pnpm --dir examples/06-cordis-hmr-demo run start:bun",
    "example:cordis-isolate-demo": "pnpm --dir examples/04-cordis-isolate-demo run start",
    "example:cordis-isolate-demo:bun": "pnpm --dir examples/04-cordis-isolate-demo run start:bun",
    "example:cordis-loader-demo": "pnpm --dir examples/05-cordis-loader-demo run start",
    "example:cordis-loader-demo:bun": "pnpm --dir examples/05-cordis-loader-demo run start:bun",
    "example:cordis-seam-demo": "pnpm --dir examples/01-cordis-seam-demo run start",
    "example:cordis-seam-demo:bun": "pnpm --dir examples/01-cordis-seam-demo run start:bun",
    "example:dsh-agent-loop-demo": "pnpm --dir examples/11-dsh-agent-loop-demo run start",
    "example:dsh-agent-loop-demo:bun": "pnpm --dir examples/11-dsh-agent-loop-demo run start:bun",
    "example:dsh-boot-demo": "pnpm --dir examples/07-dsh-boot-demo run start",
    "example:dsh-boot-demo:bun": "pnpm --dir examples/07-dsh-boot-demo run start:bun",
    "example:dsh-chat-demo": "pnpm --dir examples/21-dsh-chat-demo run start",
    "example:dsh-chat-demo:bun": "pnpm --dir examples/21-dsh-chat-demo run start:bun",
    "example:dsh-context-demo": "pnpm --dir examples/09-dsh-context-demo run start",
    "example:dsh-context-demo:bun": "pnpm --dir examples/09-dsh-context-demo run start:bun",
    "example:dsh-guardrail-demo": "pnpm --dir examples/20-dsh-guardrail-demo run start",
    "example:dsh-guardrail-demo:bun": "pnpm --dir examples/20-dsh-guardrail-demo run start:bun",
    "example:dsh-hitl-demo": "pnpm --dir examples/14-dsh-hitl-demo run start",
    "example:dsh-hitl-demo:bun": "pnpm --dir examples/14-dsh-hitl-demo run start:bun",
    "example:dsh-jobs-demo": "pnpm --dir examples/17-dsh-jobs-demo run start",
    "example:dsh-jobs-demo:bun": "pnpm --dir examples/17-dsh-jobs-demo run start:bun",
    "example:dsh-llm-adapter-demo": "pnpm --dir examples/10-dsh-llm-adapter-demo run start",
    "example:dsh-llm-adapter-demo:bun": "pnpm --dir examples/10-dsh-llm-adapter-demo run start:bun",
    "example:dsh-perf-metrics-demo": "pnpm --dir examples/22-dsh-perf-metrics-demo run start",
    "example:dsh-perf-metrics-demo:bun": "pnpm --dir examples/22-dsh-perf-metrics-demo run start:bun",
    "example:dsh-sandbox-demo": "pnpm --dir examples/15-dsh-sandbox-demo run start",
    "example:dsh-sandbox-demo:bun": "pnpm --dir examples/15-dsh-sandbox-demo run start:bun",
    "example:dsh-session-demo": "pnpm --dir examples/12-dsh-session-demo run start",
    "example:dsh-session-demo:bun": "pnpm --dir examples/12-dsh-session-demo run start:bun",
    "example:dsh-skills-mcp-demo": "pnpm --dir examples/18-dsh-skills-mcp-demo run start",
    "example:dsh-skills-mcp-demo:bun": "pnpm --dir examples/18-dsh-skills-mcp-demo run start:bun",
    "example:dsh-storage-demo": "pnpm --dir examples/19-dsh-storage-demo run start",
    "example:dsh-storage-demo:bun": "pnpm --dir examples/19-dsh-storage-demo run start:bun",
    "example:dsh-subagent-demo": "pnpm --dir examples/16-dsh-subagent-demo run start",
    "example:dsh-subagent-demo:bun": "pnpm --dir examples/16-dsh-subagent-demo run start:bun",
    "example:dsh-tool-pipeline-demo": "pnpm --dir examples/08-dsh-tool-pipeline-demo run start",
    "example:dsh-tool-pipeline-demo:bun": "pnpm --dir examples/08-dsh-tool-pipeline-demo run start:bun",
    "example:dsh-trajectory-probe-demo": "pnpm --dir examples/13-dsh-trajectory-probe-demo run start",
    "example:dsh-trajectory-probe-demo:bun": "pnpm --dir examples/13-dsh-trajectory-probe-demo run start:bun",
    "install:all": "node runtime/install-all.mjs",
    "runtime:status": "node runtime/status.mjs",
    "verify": "node runtime/verify.mjs",
    "check:copies": "node runtime/check-copies.mjs",
    "check:deprecated": "node runtime/check-deprecated.mjs",
    "check:shim": "node runtime/run.mjs --runtime bun runtime/check-bun-shim.mjs"
  },
  "//dependencies": "根层零依赖：runtime/ 全部是零依赖 .mjs；业务依赖都在各示例自己的 package.json 里（@deepseek-ai/* 0.2.2-rc.5，cordis 4.1.0），由 pnpm 按示例各自安装。",
  "packageManager": "pnpm@11.28.5",
  "//examples": "每个示例完全独立：example:<name> 代跑该示例的 start（Node，经 tsx 加载），:bun 变体走示例自带调度器；安装与运行统一用 pnpm。"
}
