{
  "name": "dsh-lab",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "一文一工程的 dsh/cordis 示例集：examples/ 下 21 个完全独立的示例（cordis 6 + dsh 15），各自带完整装配、README 主题文章与 Node/Bun 双运行时脚本。根层只保留运行时工具（调度/状态/校验/shim 契约）。",
  "engines": {
    "node": ">=22.18",
    "bun": ">=1.4.4"
  },
  "scripts": {
    "//examples": "每个示例完全独立：example:<name> 代跑该示例的 start（Node），:bun 变体走示例自带调度器。",
    "//verify": "遍历 examples/：每示例 typecheck + start（Node）+ start:bun（Bun），末行 RUNTIMES_VERIFY_OK runtimes=2 checks=N。缺 key 的示例按明确失败计入报告。",
    "example:cordis-events-demo": "npm --prefix examples/cordis-events-demo start",
    "example:cordis-events-demo:bun": "npm --prefix examples/cordis-events-demo run start:bun",
    "example:cordis-fiber-demo": "npm --prefix examples/cordis-fiber-demo start",
    "example:cordis-fiber-demo:bun": "npm --prefix examples/cordis-fiber-demo run start:bun",
    "example:cordis-hmr-demo": "npm --prefix examples/cordis-hmr-demo start",
    "example:cordis-hmr-demo:bun": "npm --prefix examples/cordis-hmr-demo run start:bun",
    "example:cordis-isolate-demo": "npm --prefix examples/cordis-isolate-demo start",
    "example:cordis-isolate-demo:bun": "npm --prefix examples/cordis-isolate-demo run start:bun",
    "example:cordis-loader-demo": "npm --prefix examples/cordis-loader-demo start",
    "example:cordis-loader-demo:bun": "npm --prefix examples/cordis-loader-demo run start:bun",
    "example:cordis-seam-demo": "npm --prefix examples/cordis-seam-demo start",
    "example:cordis-seam-demo:bun": "npm --prefix examples/cordis-seam-demo run start:bun",
    "example:dsh-agent-loop-demo": "npm --prefix examples/dsh-agent-loop-demo start",
    "example:dsh-agent-loop-demo:bun": "npm --prefix examples/dsh-agent-loop-demo run start:bun",
    "example:dsh-boot-demo": "npm --prefix examples/dsh-boot-demo start",
    "example:dsh-boot-demo:bun": "npm --prefix examples/dsh-boot-demo run start:bun",
    "example:dsh-chat-demo": "npm --prefix examples/dsh-chat-demo start",
    "example:dsh-chat-demo:bun": "npm --prefix examples/dsh-chat-demo run start:bun",
    "example:dsh-context-demo": "npm --prefix examples/dsh-context-demo start",
    "example:dsh-context-demo:bun": "npm --prefix examples/dsh-context-demo run start:bun",
    "example:dsh-guardrail-demo": "npm --prefix examples/dsh-guardrail-demo start",
    "example:dsh-guardrail-demo:bun": "npm --prefix examples/dsh-guardrail-demo run start:bun",
    "example:dsh-hitl-demo": "npm --prefix examples/dsh-hitl-demo start",
    "example:dsh-hitl-demo:bun": "npm --prefix examples/dsh-hitl-demo run start:bun",
    "example:dsh-jobs-demo": "npm --prefix examples/dsh-jobs-demo start",
    "example:dsh-jobs-demo:bun": "npm --prefix examples/dsh-jobs-demo run start:bun",
    "example:dsh-llm-adapter-demo": "npm --prefix examples/dsh-llm-adapter-demo start",
    "example:dsh-llm-adapter-demo:bun": "npm --prefix examples/dsh-llm-adapter-demo run start:bun",
    "example:dsh-sandbox-demo": "npm --prefix examples/dsh-sandbox-demo start",
    "example:dsh-sandbox-demo:bun": "npm --prefix examples/dsh-sandbox-demo run start:bun",
    "example:dsh-session-demo": "npm --prefix examples/dsh-session-demo start",
    "example:dsh-session-demo:bun": "npm --prefix examples/dsh-session-demo run start:bun",
    "example:dsh-skills-mcp-demo": "npm --prefix examples/dsh-skills-mcp-demo start",
    "example:dsh-skills-mcp-demo:bun": "npm --prefix examples/dsh-skills-mcp-demo run start:bun",
    "example:dsh-storage-demo": "npm --prefix examples/dsh-storage-demo start",
    "example:dsh-storage-demo:bun": "npm --prefix examples/dsh-storage-demo run start:bun",
    "example:dsh-subagent-demo": "npm --prefix examples/dsh-subagent-demo start",
    "example:dsh-subagent-demo:bun": "npm --prefix examples/dsh-subagent-demo run start:bun",
    "example:dsh-tool-pipeline-demo": "npm --prefix examples/dsh-tool-pipeline-demo start",
    "example:dsh-tool-pipeline-demo:bun": "npm --prefix examples/dsh-tool-pipeline-demo run start:bun",
    "example:dsh-trajectory-probe-demo": "npm --prefix examples/dsh-trajectory-probe-demo start",
    "example:dsh-trajectory-probe-demo:bun": "npm --prefix examples/dsh-trajectory-probe-demo run start:bun",
    "install:all": "node runtime/install-all.mjs",
    "runtime:status": "node runtime/status.mjs",
    "verify": "node runtime/verify.mjs",
    "check:shim": "node runtime/run.mjs --runtime bun runtime/check-bun-shim.mjs"
  },
  "//dependencies": "根层零依赖：runtime/ 全部是零依赖 .mjs；业务依赖都在各示例自己的 package.json 里（@deepseek-ai/* 0.2.2-rc.3，cordis 4.1.0）。"
}
