{
  "name": "dsh-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "基于 @deepseek-ai/dsh 0.2.2-rc.1 的独立交互式示例工程：12 个能力模块（M01–M12）+ 完整人机交互（交互式 CLI REPL、审批、提问、斜杠命令）+ 安全护栏插件 + 会话 trajectory 记录与查看。",
  "engines": {
    "node": ">=22.18",
    "bun": ">=1.4.4"
  },
  "bin": {
    "dsh-lab": "src/cli/bin.ts"
  },
  "//scripts": "Node 原生 type-stripping 直接运行 .ts（需 Node ≥ 22.18）。dsh-lab 用官方 dsh-app-boot 的 boot() 装配 cordis 配置树；模型调用走 M03 的 anthropic-compat 适配器（缺 LLM_API_KEY 立即失败，无离线回退）。",
  "scripts": {
    "//runtimes": "双运行时：Node 与 Bun 都验证过（npm run verify）。所有命令经 runtime/run.mjs 调度，默认 node；:bun 变体走 Bun，DSH_RUNTIME=bun 可改默认值。",
    "//bin": "dsh-lab 入口（npm link 后可直接用 dsh-lab 命令）。",
    "dsh-lab": "node runtime/run.mjs src/cli/bin.ts",
    "dsh-lab:bun": "node runtime/run.mjs --runtime bun src/cli/bin.ts",
    "chat": "node runtime/run.mjs src/cli/bin.ts chat",
    "chat:bun": "node runtime/run.mjs --runtime bun src/cli/bin.ts chat",
    "traj": "node runtime/run.mjs src/cli/bin.ts traj",
    "traj:bun": "node runtime/run.mjs --runtime bun src/cli/bin.ts traj",
    "sessions": "node runtime/run.mjs src/cli/bin.ts sessions",
    "sessions:bun": "node runtime/run.mjs --runtime bun src/cli/bin.ts sessions",
    "//modules": "12 个模块各跑自己的阶段；:bun 变体在 Bun 上跑同一份阶段清单。",
    "M01": "node runtime/run.mjs src/cli/bin.ts run M01",
    "M01:bun": "node runtime/run.mjs --runtime bun src/cli/bin.ts run M01",
    "M02": "node runtime/run.mjs src/cli/bin.ts run M02",
    "M02:bun": "node runtime/run.mjs --runtime bun src/cli/bin.ts run M02",
    "M03": "node runtime/run.mjs src/cli/bin.ts run M03",
    "M03:bun": "node runtime/run.mjs --runtime bun src/cli/bin.ts run M03",
    "M04": "node runtime/run.mjs src/cli/bin.ts run M04",
    "M04:bun": "node runtime/run.mjs --runtime bun src/cli/bin.ts run M04",
    "M05": "node runtime/run.mjs src/cli/bin.ts run M05",
    "M05:bun": "node runtime/run.mjs --runtime bun src/cli/bin.ts run M05",
    "M06": "node runtime/run.mjs src/cli/bin.ts run M06",
    "M06:bun": "node runtime/run.mjs --runtime bun src/cli/bin.ts run M06",
    "M07": "node runtime/run.mjs src/cli/bin.ts run M07",
    "M07:bun": "node runtime/run.mjs --runtime bun src/cli/bin.ts run M07",
    "M08": "node runtime/run.mjs src/cli/bin.ts run M08",
    "M08:bun": "node runtime/run.mjs --runtime bun src/cli/bin.ts run M08",
    "M09": "node runtime/run.mjs src/cli/bin.ts run M09",
    "M09:bun": "node runtime/run.mjs --runtime bun src/cli/bin.ts run M09",
    "M10": "node runtime/run.mjs src/cli/bin.ts run M10",
    "M10:bun": "node runtime/run.mjs --runtime bun src/cli/bin.ts run M10",
    "M11": "node runtime/run.mjs src/cli/bin.ts run M11",
    "M11:bun": "node runtime/run.mjs --runtime bun src/cli/bin.ts run M11",
    "M12": "node runtime/run.mjs src/cli/bin.ts run M12",
    "M12:bun": "node runtime/run.mjs --runtime bun src/cli/bin.ts run M12",
    "//all": "全量 60 阶段：会发起真实模型请求，缺 LLM_API_KEY 立即失败（无离线回退）。",
    "all": "node runtime/run.mjs src/cli/bin.ts run all",
    "all:bun": "node runtime/run.mjs --runtime bun src/cli/bin.ts run all",
    "//test": "对真实 SDK 与装配树的冒烟测试；需要真实 provider 的用例在缺 LLM_API_KEY 时 skip。",
    "test": "node runtime/run.mjs --test",
    "test:bun": "node runtime/run.mjs --runtime bun --test",
    "//typecheck": "把全部源码直接编译到真实包自带的 .d.ts 上。",
    "typecheck": "node runtime/run.mjs --typecheck",
    "typecheck:bun": "node runtime/run.mjs --runtime bun --typecheck",
    "//runtime": "运行时层自身的工具：状态盘点、双运行时并排校验、Bun shim 契约校验。",
    "runtime:status": "node runtime/status.mjs",
    "//verify": "两套运行时各跑 typecheck / test / 启动探针，末行打印 RUNTIMES_VERIFY_OK。",
    "verify": "node runtime/verify.mjs",
    "//check:shim": "校验 Bun 侧的 stripTypeScriptTypes 替身仍满足上游的位置契约（只在 Bun 下有意义）。",
    "check:shim": "node runtime/run.mjs --runtime bun runtime/check-bun-shim.mjs"
  },
