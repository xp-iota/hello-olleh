    "@cordisjs/loader": "1.0.0-rc.10",
    "@cordisjs/timer": "1.1.5",
    "cordis": "4.0.0-rc.13"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "7.0.2"
  }
}