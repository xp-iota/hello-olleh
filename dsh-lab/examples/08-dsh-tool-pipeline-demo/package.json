{
  "name": "dsh-tool-pipeline-demo",
  "private": true,
  "type": "module",
  "description": "工具管线五段：注册与 effect 回收、pre-execute 权限门、post-execute 结果变换、按 agent 收紧可见性、单调守卫。Node 与 Bun 双运行时。",
  "engines": {
    "node": ">=22.18"
  },
