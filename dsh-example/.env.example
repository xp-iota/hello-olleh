# 真实推理服务 provider 配置模板 —— 复制为 .env 并填入真实密钥。
# 本模板可入库（.gitignore 的 !.env.example 例外）；.env 本身永不入库。
#
# 变量名刻意不带厂商前缀：适配器走 Anthropic 兼容协议，同一份配置既能指向
# MiniMax，也能指向其他同等兼容的服务。

# 推理服务密钥。
LLM_API_KEY=

# Anthropic 兼容端点与模型 id —— 不设则用适配器内置默认值
# （https://api.minimaxi.com/anthropic 与 MiniMax-M3）。
# LLM_BASE_URL=https://api.minimaxi.com/anthropic
# LLM_MODEL=MiniMax-M3

# runTurn 默认 provider 选路（mock / anthropic-compat）。
# 注意：设为 anthropic-compat 后 `npm run all` 会对每个 runTurn 示例发起真实请求，套件不再离线。
# DSH_PROVIDER=anthropic-compat
