{
  "//": "示例用的宽松 tsconfig：类型全部来自真实 @deepseek-ai/* 包自带的 .d.ts（node_modules）。",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["M??-*/**/*.ts", "runtime/*.ts"],
  "exclude": ["node_modules"]
}
