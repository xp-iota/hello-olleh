{
  "name": "@example/dsh-examples",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Runnable DeepSeek Harness 0.1.5-rc.2 teaching project: 12 capability modules, 59 service/seam surfaces, offline gates, and optional real-provider paths.",
  "engines": {
    "node": ">=22.18"
  },
  "//scripts": "每个示例由 Node 原生 type-stripping 直接运行 .ts（需 Node ≥ 22.18）。runtime/harness.ts 启动时用 process.loadEnvFile 加载工程根 .env（真实 provider 密钥，文件不存在则静默跳过）。",
  "scripts": {
    "learn": "node runtime/onboarding.mjs",
    "M01": "node M01-tool-pipeline/run.ts",
    "//M01:real": "真实 MiniMax 自主调用 word_count；需要 MINIMAX_API_KEY，会发起网络请求。",
    "M01:real": "node M01-tool-pipeline/run-real.ts",
    "M02": "node M02-context-assembly-economics/run.ts",
    "M03": "node M03-inference-service-access/run.ts",
    "//M03:real": "同一 StreamChunk 消费循环接入真实 MiniMax；需要 MINIMAX_API_KEY。",
    "M03:real": "node M03-inference-service-access/run-real.ts",
    "M04": "node M04-agent-loop-intervention/run.ts",
    "M05": "node M05-session-surface/run.ts",
    "M06": "node M06-human-in-the-loop/run.ts",
    "M07": "node M07-execution-backends/run.ts",
    "M08": "node M08-delegation-presets/run.ts",
    "M09": "node M09-long-running-orchestration/run.ts",
    "M10": "node M10-external-capabilities/run.ts",
    "//M10:real": "真实 MiniMax 对照注入 SKILL.md 前后的作答；需要 MINIMAX_API_KEY。",
    "M10:real": "node M10-external-capabilities/run-real.ts",
    "M11": "node M11-config-data-infrastructure/run.ts",
    "M12": "node M12-framework-mechanisms/run.ts",
    "//test": "对真实 SDK 的离线冒烟测试与 provider wire 协议回归测试。",
    "test": "node --test runtime/*.test.ts",
    "//typecheck": "把所有 steps/phases/real/support 直接编译到真实包自带的 .d.ts 上。",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "all": "bash ./runtime/run-all.sh",
    "coverage:a4": "node runtime/a4-coverage.ts"
  },
