  "cards": [
    {
      "dot": "cyan",
      "title": "按用途选模式",
      "items": [
        "只想广播用 emit，不关心结果",
        "想问「谁能处理」用 bail 或 serial",
        "想改写或替换默认行为用 waterfall"
      ]
    },
    {
      "dot": "rose",
      "title": "非空判定的陷阱",
      "items": [
        "数字 0 与空字符串都被判为非空",
        "监听器返回 0 会意外中断整条链",
        "要表达「我不处理」必须返回 null、false 或不返回"
      ]
    },
    {
      "dot": "emerald",
      "title": "同步与异步的对应关系",
      "items": [
        "bail 与 serial 语义相同，差别只在是否 await",
        "emit 与 parallel 同为无返回值的通知",
        "parallel 用 allSettled，单个失败不影响其余"
      ]
    }
  ]
