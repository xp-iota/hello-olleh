      "variant": "emphasis"
    },
    {
      "id": "start-reload",
      "from": "setepoch",
      "to": "reload",
      "y": 234,
      "label": "inertia = _reload()，state = LOADING",
      "note": "await 执行插件代码，这段时间是可被打断的窗口"
    },
    {
      "id": "epoch-second",
      "from": "outside",
      "to": "setepoch",
      "y": 328,
      "label": "epoch: ':3' 变为 ':9'",
      "variant": "emphasis",
      "note": "inertia 已存在，_setEpoch 只记下新 epoch 就返回，不重入"
    },
    {
      "id": "to-unload",
      "from": "reload",
      "to": "unload",
      "y": 447,
      "label": "inertia = _unload()，state = UNLOADING",
      "note": "_reload 收尾时发现 _runner.epoch 已不等于 oldEpoch"
    },
    {
      "id": "back-to-reload",
      "from": "unload",
      "to": "reload",
      "y": 506,
      "label": "inertia = _reload()，state = LOADING",
      "variant": "emphasis",
      "note": "disposer 并发跑完（启动顺序逆序）后 epoch 不是 INACTIVE，直接重载"
    },
    {
      "id": "settled",
      "from": "reload",
      "to": "setepoch",
      "y": 565,
      "label": "inertia 归空，state = ACTIVE",
      "variant": "return",
      "note": "这一轮 epoch 一致，竞态收敛"
    }
