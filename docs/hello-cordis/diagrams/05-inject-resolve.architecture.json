  "connections": [
    {
      "id": "a",
      "from": "enter",
      "to": "empty"
    },
    {
      "id": "b",
      "from": "enter",
      "to": "arr",
      "variant": "emphasis"
    },
    {
      "id": "c",
      "from": "enter",
      "to": "proto"
    },
    {
      "id": "d",
