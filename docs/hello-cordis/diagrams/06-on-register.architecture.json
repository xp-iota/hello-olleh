  "cards": [
    {
      "dot": "cyan",
      "title": "为什么要 bind 一层",
      "items": [
        "监听器内的 this 与参数都要经过 traceable",
        "这样它登记的副作用才归属正确的调用方",
        "代价是监听器拿到的不是原始对象"
      ]
    },
    {
      "dot": "amber",
      "title": "internal/listener 是注册劫持点",
      "items": [
        "用 bail 派发，任一监听器返回非空即接管",
        "可用于把事件转发到别的进程或做去重",
        "返回空则走默认注册流程"
      ]
    },
    {
      "dot": "emerald",
      "title": "注册本身可逆",
      "items": [
        "register 包在 fiber.effect 里",
        "setup 按 prepend 决定 push 还是 unshift",
        "插件卸载时自动 unregister，不留悬挂监听"
      ]
    }
  ]
