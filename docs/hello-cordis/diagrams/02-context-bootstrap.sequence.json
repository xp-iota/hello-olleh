  "segments": [
    {
      "from": 150,
      "to": 300,
      "label": "建立代理与根 Fiber"
    },
    {
      "from": 320,
      "to": 512,
      "label": "挂载四个内建服务"
    },
    {
      "from": 520,
      "to": 640,
      "label": "收尾"
    }
  ],
  "messages": [
    {
      "id": "make-proxy",
      "from": "ctor",
      "to": "proxy",
      "y": 190,
      "label": "self = new Proxy(this, ReflectService.handler)",
      "variant": "emphasis",
      "note": "构造前先置 this[isolate] = {} 与 this[intercept] = {}；从这一刻起属性访问都走 Proxy trap"
    },
    {
      "id": "root-fiber",
      "from": "ctor",
      "to": "fiber",
      "y": 248,
      "label": "this.fiber = new Fiber(self, {}, {}, null)",
      "note": "runtime 为 null 即根 Fiber，uid=0，state 直接 ACTIVE（fiber.ts:200-212）"
    },
    {
      "id": "mount-reflect",
      "from": "ctor",
      "to": "reflect",
      "y": 340,
      "label": "this.reflect = new ReflectService(self)",
      "note": "构造函数里 mixin 四组方法（reflect.ts:144-147）"
    },
    {
      "id": "mount-registry",
      "from": "ctor",
      "to": "registry",
      "y": 392,
      "label": "this.registry = new RegistryService(self)"
    },
    {
      "id": "mount-events",
      "from": "ctor",
      "to": "events",
      "y": 444,
      "label": "this.events = new EventsService(self)"
    },
    {
      "id": "mount-logger",
      "from": "ctor",
      "to": "logger",
      "y": 496,
      "label": "this.logger = new LoggerService(self)"
    },
    {
      "id": "clear-disposables",
      "from": "ctor",
      "to": "fiber",
      "y": 560,
      "label": "this.fiber._disposables.clear()",
      "variant": "dashed",
      "note": "清空自举期间登记的 disposer，否则根 Fiber 一 restart 就把自己拆了"
    },
    {
      "id": "return-self",
      "from": "proxy",
      "to": "ctor",
      "y": 616,
      "label": "return self（并设 this.root = self）",
      "variant": "return",
      "note": "用户拿到的 ctx 始终是 Proxy，不是 Context 实例本身"
    }
  ],
  "activations": [
    {
      "participant": "proxy",
      "from": 185,
