    },
    {
      "participant": "logger",
      "from": 491,
      "to": 556,
      "type": "cloud"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "顺序为什么不能换",
      "items": [
        "Proxy 必须最先建立，后续所有属性访问都依赖它",
        "根 Fiber 必须在服务之前，服务要挂到 Fiber 的 effect 上",
        "ReflectService 先于其余三个服务，因为它提供解析能力"
      ]
    },
    {
      "dot": "amber",
      "title": "根 Fiber 的特殊性",
      "items": [
        "runtime 传 null 是根 Fiber 的唯一标识",
        "uid 固定为 0，state 跳过 PENDING 直接 ACTIVE",
        "没有父 Fiber，因此不参与 epoch 依赖追踪"
      ]
    },
    {
      "dot": "rose",
      "title": "自举期的陷阱",
      "items": [
        "四个内建服务在挂载时会往根 Fiber 登记 disposer",
        "这些 disposer 是自举产物，不应参与 restart",
        "所以末尾要 _disposables.clear() 把它们丢掉"
      ]
    }
  ]
}
