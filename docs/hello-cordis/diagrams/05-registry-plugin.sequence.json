  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime 按 callback 去重",
      "items": [
        "同一个插件函数多次注册共享一个 Plugin.Runtime",
        "Runtime 上的 fibers 是 DisposableList，记录全部实例",
        "热重载删插件时靠它找到所有待卸载的 Fiber"
      ]
    },
    {
      "dot": "violet",
      "title": "返回值刻意是 thenable",
      "items": [
        "wrapped 用 Object.create(fiber) 继承 Fiber 全部能力",
        "额外挂 then 让调用方可以 await 到插件就绪",
        "而 ctx 自身把 then 列为保留字，避免被 await 吞掉"
      ]
    },
    {
      "dot": "amber",
      "title": "长堆栈的起点",
      "items": [
        "getOuterStack 用默认参数在调用处求值",
        "捕获的是用户代码的真实调用位置",
        "之后异步错误会把这段栈拼上去"
      ]
    }
  ]
}
