      "id": "runtime-hit",
      "from": "internal",
      "to": "registry",
      "y": 367,
      "label": "命中则复用，未命中则新建",
      "variant": "return"
    },
    {
      "id": "set-runtime",
      "from": "registry",
      "to": "internal",
      "y": 414,
      "label": "set(callback, { name, callback, fibers, Config })",
      "variant": "dashed",
      "note": "首次注册才走这步；name 取 p.name，若为 apply 则不记名（:201-202）"
    },
    {
      "id": "new-fiber",
      "from": "registry",
      "to": "fiber",
