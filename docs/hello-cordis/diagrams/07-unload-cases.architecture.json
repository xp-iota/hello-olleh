  "cards": [
    {
      "dot": "rose",
      "title": "为什么需要五道排除",
      "items": [
        "loader 要区分「用户主动禁用」与其余情形",
        "只有前者该把 disabled 写回配置文件",
        "误判会导致配置被意外改写"
      ]
    },
    {
      "dot": "cyan",
      "title": "case 4 是 HMR 的关键",
      "items": [
        "HMR 的顺序是先 registry.delete 再 dispose",
        "于是此刻 registry 里已查不到该 callback",
        "靠这个特征把热重载与真卸载区分开"
      ]
    },
    {
      "dot": "emerald",
      "title": "事件本身一体两用",
      "items": [
        "internal/plugin 在创建与卸载时各发一次",
        "case 1 用 fiber.uid 把创建事件先滤掉",
        "其余四道逐层排除非用户意图的卸载"
      ]
    }
