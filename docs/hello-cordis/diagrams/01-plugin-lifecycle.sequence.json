  "cards": [
    {
      "dot": "emerald",
      "title": "主链路",
      "items": [
        "RegistryService 把插件解析成 Plugin.Runtime",
        "每次 ctx.plugin() 产生一个独立 Fiber",
        "真正执行插件函数的是 Fiber 的 _reload()"
      ]
    },
    {
      "dot": "cyan",
      "title": "epoch 依赖追踪",
      "items": [
        "无依赖插件 epoch 为空串，立即激活",
        "依赖命中后 epoch 变为 ':1'",
        "epoch 变化是 unload 再 reload 的唯一触发条件"
      ]
    },
    {
      "dot": "violet",
      "title": "可逆效应",
      "items": [
        "provide 经 fiber.effect() 登记，卸载时自动撤销",
        "disposer 挂在所属 Fiber 的 _disposables 上",
        "同一 effect 内的 disposer 严格逆序执行"
      ]
    }
  ]
}
