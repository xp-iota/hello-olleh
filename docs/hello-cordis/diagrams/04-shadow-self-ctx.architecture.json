    {
      "dot": "cyan",
      "title": "为什么默认要劫持",
      "items": [
        "服务方法里用调用方 ctx 才能正确归属副作用",
        "否则调用方卸载时服务里登记的 effect 不会回收",
        "这是可逆性跨服务边界的保证"
      ]
    },
    {
      "dot": "emerald",
      "title": "shadow 是逃生舱",
      "items": [
        "仅当服务确实需要读自己的配置时才走 shadow 取回",
        "服务确实需要读自己的配置时才用",
        "藏在原型上，不污染正常属性访问",
        "解包是显式动作，不会误触发"
      ]
    },
    {
      "dot": "violet",
      "title": "两条路径要分清",
      "items": [
        "this.ctx 给的是调用方视角",
        "经 shadow 解包拿到的是服务自身视角",
        "混用会导致副作用归属错乱"
      ]
    }
