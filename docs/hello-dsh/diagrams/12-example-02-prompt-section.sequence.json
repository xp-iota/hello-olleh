{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "注入一段 System Prompt：section 注册到 assemble 排序的完整链路",
    "output": "12-example-02-prompt-section.html",
    "viewBox": [1680, 760],
    "quality_profile": "showcase",
    "column_fit": "spread"
  },
  "participants": [
    { "id": "script", "type": "external", "label": "run.ts", "sublabel": "示例入口脚本" },
    { "id": "harness", "type": "backend", "label": "createHarness", "sublabel": "runtime/harness.ts 装配层" },
    { "id": "plugin", "type": "backend", "label": "prompt-section", "sublabel": "02-prompt-section/index.ts" },
    { "id": "prompt", "type": "messagebus", "label": "ctx.systemPrompt", "sublabel": "真实 SystemPrompt 服务" },
    { "id": "render", "type": "external", "label": "renderPrompt", "sublabel": "@deepseek-ai/dsh-system-prompt" }
  ],
  "segments": [
    { "from": 155, "to": 445, "label": "装配与注册" },
    { "from": 465, "to": 665, "label": "组装与渲染" }
  ],
  "messages": [
    {
      "id": "assemble-harness",
      "from": "script",
      "to": "harness",
      "y": 195,
      "label": "createHarness()：按依赖序装真实 @deepseek-ai/* 服务",
      "variant": "emphasis"
    },
    {
      "id": "persona",
      "from": "script",
      "to": "prompt",
      "y": 250,
      "label": "① section({ name:'persona', order:0 })",
      "note": "约定：-100 harness 身份，0 部署 persona，100~199 工具指引"
    },
    {
      "id": "load",
      "from": "script",
      "to": "harness",
      "y": 305,
      "label": "loadPlugin(插件, { signature:'—— 来自扩展示例工程' })"
    },
    {
      "id": "apply",
      "from": "harness",
      "to": "plugin",
      "y": 360,
      "label": "inject ['systemPrompt'] 就绪后才运行 apply(ctx, config)"
    },
    {
      "id": "section",
      "from": "plugin",
      "to": "prompt",
      "y": 415,
      "label": "② section({ name:'example-reply-style', order:300 })",
      "variant": "security",
      "note": "config.signature 由 schemastery Config 校验后拼进 text"
    },
    {
      "id": "call-assemble",
      "from": "script",
      "to": "prompt",
      "y": 505,
      "label": "③ assemble(assembleContext())",
      "variant": "emphasis"
    },
    {
      "id": "assembly",
      "from": "prompt",
      "to": "script",
      "y": 560,
      "label": "PromptAssembly：收集所有段并按 order 升序排列",
      "variant": "return"
    },
    {
      "id": "print",
      "from": "script",
      "to": "render",
      "y": 615,
      "label": "④ renderPrompt(assembly) 渲染成最终字符串并打印"
    }
  ],
  "activations": [
    { "participant": "harness", "from": 190, "to": 365, "type": "backend" },
    { "participant": "plugin", "from": 355, "to": 420, "type": "backend" },
    { "participant": "prompt", "from": 245, "to": 565, "type": "messagebus" },
    { "participant": "render", "from": 610, "to": 660, "type": "external" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "片段按 order 升序拼接",
      "items": [
        "persona 是 order=0，本例署名段是 order=300",
        "assemble() 负责收集并排序，插件不关心邻居",
        "约定：-100 身份 / 0 persona / 100~199 工具指引"
      ]
    },
    {
      "dot": "cyan",
      "title": "text 可以静态也可以动态",
      "items": [
        "静态字符串满足大多数场景",
        "换成 (context) => string 即可每次组装时求值",
        "同名 section 同层会抛错，scoped 注册可遮蔽"
      ]
    },
    {
      "dot": "violet",
      "title": "配置走 schemastery，不硬编码",
      "items": [
        "Config 用 z.object 声明并带默认值",
        "cordis.yml 的 config 可覆盖，支持环境变量 fallback",
        "apply 返回的 disposer 由插件 fiber 自动回收"
      ]
    }
  ]
}
