{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "换真实推理服务后，一次 word_count 工具调用的完整回路",
    "output": "12-example-minimax-loop.html",
    "viewBox": [
      1680,
      880
    ],
    "quality_profile": "showcase",
    "column_fit": "spread"
  },
  "participants": [
    {
      "id": "user",
      "type": "external",
      "label": "用户 query",
      "sublabel": "明确禁止模型自己数"
    },
    {
      "id": "loop",
      "type": "backend",
      "label": "agent-loop",
      "sublabel": "真实 turn 与 step 主循环"
    },
    {
      "id": "adapter",
      "type": "backend",
      "label": "MinimaxAnthropicAdapter",
      "sublabel": "runtime/llm-minimax.ts"
    },
    {
      "id": "minimax",
      "type": "cloud",
      "label": "MiniMax",
      "sublabel": "Anthropic 兼容 SSE 端点"
    },
    {
      "id": "tools",
      "type": "security",
      "label": "ctx.tools",
      "sublabel": "工具管线与参数校验"
    },
    {
      "id": "tool",
      "type": "backend",
      "label": "word_count",
      "sublabel": "01-tool-wordcount/index.ts"
    },
    {
      "id": "session",
      "type": "messagebus",
      "label": "会话日志",
      "sublabel": "session.events 是唯一事实源"
    }
  ],
  "segments": [
    {
      "from": 155,
      "to": 430,
      "label": "第一步：模型决定调用"
    },
    {
      "from": 450,
      "to": 660,
      "label": "执行并回灌结果"
    },
    {
      "from": 680,
      "to": 800,
      "label": "第二步：模型收尾"
    }
  ],
  "messages": [
    {
      "id": "ask",
      "from": "user",
      "to": "loop",
      "y": 195,
      "label": "统计词数与字符数，必须调用 word_count",
      "variant": "emphasis"
    },
    {
      "id": "req1",
      "from": "loop",
      "to": "adapter",
      "y": 250,
      "label": "带工具 schema 发起第一次请求",
      "note": "工具的 description 与 parameters 由 systemPrompt 自动汇入，无需手写登记"
    },
    {
      "id": "post1",
      "from": "adapter",
      "to": "minimax",
      "y": 305,
      "label": "POST /v1/messages（stream 与 tools）"
    },
    {
      "id": "tooluse",
      "from": "minimax",
      "to": "adapter",
      "y": 355,
      "label": "tool_use 块，stop_reason 为 tool_use",
      "variant": "emphasis"
    },
    {
      "id": "chunk",
      "from": "adapter",
      "to": "loop",
      "y": 405,
      "label": "翻译成 dsh 的 tool-call chunk",
      "variant": "return"
    },
    {
      "id": "dispatch",
      "from": "loop",
      "to": "tools",
      "y": 480,
      "label": "派发 ctx.tools.execute"
    },
    {
      "id": "exec",
      "from": "tools",
      "to": "tool",
      "y": 530,
      "label": "execute(args)，参数已按 schema 校验",
      "variant": "security"
    },
    {
      "id": "value",
      "from": "tool",
      "to": "tools",
      "y": 580,
      "label": "规范值 words 7 与 chars 49",
      "variant": "return"
    },
    {
      "id": "log",
      "from": "tools",
      "to": "session",
      "y": 630,
      "label": "tool/result 落日志，output.render 出模型可见文本"
    },
    {
      "id": "req2",
      "from": "loop",
      "to": "minimax",
      "y": 715,
      "label": "带工具结果发起第二次请求",
      "note": "同样经适配器翻译；实测两次请求都携带 tools 列表"
    },
    {
      "id": "final",
      "from": "minimax",
      "to": "loop",
      "y": 765,
      "label": "文本收尾，本轮 step 数为 2",
      "variant": "emphasis"
    }
  ],
  "activations": [
    {
      "participant": "loop",
      "from": 190,
      "to": 771,
      "type": "backend"
    },
    {
      "participant": "adapter",
      "from": 245,
      "to": 411,
      "type": "backend"
    },
    {
      "participant": "minimax",
      "from": 300,
      "to": 361,
      "type": "cloud"
    },
    {
      "participant": "tools",
      "from": 475,
      "to": 636,
      "type": "security"
    },
    {
      "participant": "tool",
      "from": 525,
      "to": 586,
      "type": "backend"
    },
    {
      "participant": "session",
      "from": 625,
      "to": 636,
      "type": "messagebus"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "工具没有为对接模型改一行",
      "items": [
        "01 注册的 defineTool 原样复用",
        "只把 provider 从 mock 换成 anthropic-compat",
        "schema 汇入提示由 systemPrompt 负责"
      ]
    },
    {
      "dot": "cyan",
      "title": "证据取自会话日志",
      "items": [
        "tool-call 与 tool-result 都从 session.events 读",
        "不依赖适配器自报调用成功",
        "模型不调工具时脚本直接抛错"
      ]
    },
    {
      "dot": "violet",
      "title": "一次工具调用等于两步",
      "items": [
        "第一步模型只发调用意图",
        "结果回灌后才有第二步收尾",
        "实测 step 数正好是 2"
      ]
    }
  ]
}
