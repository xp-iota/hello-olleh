{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "事件观测：一个真实 turn 里 session/event 的生命周期",
    "output": "12-example-06-agent-events-telemetry.html",
    "viewBox": [1680, 640],
    "quality_profile": "showcase",
    "column_fit": "spread"
  },
  "participants": [
    { "id": "script", "type": "external", "label": "run.ts", "sublabel": "示例入口脚本" },
    { "id": "harness", "type": "backend", "label": "createHarness", "sublabel": "runtime/harness.ts 装配层" },
    { "id": "telemetry", "type": "security", "label": "telemetry 插件", "sublabel": "06-agent-events-telemetry/index.ts" },
    { "id": "loop", "type": "messagebus", "label": "agent-loop", "sublabel": "真实 turn / step 驱动" },
    { "id": "session", "type": "database", "label": "session", "sublabel": "持久会话事件流" }
  ],
  "segments": [
    { "from": 155, "to": 330, "label": "装上纯监听器" },
    { "from": 345, "to": 490, "label": "真实 turn 驱动" },
    { "from": 505, "to": 560, "label": "收尾聚合" }
  ],
  "messages": [
    {
      "id": "harness",
      "from": "script",
      "to": "harness",
      "y": 195,
      "label": "createHarness({ reply })：内置 mock 适配器固定回复",
      "variant": "emphasis"
    },
    {
      "id": "load",
      "from": "script",
      "to": "harness",
      "y": 245,
      "label": "loadPlugin(遥测插件)"
    },
    {
      "id": "listen",
      "from": "harness",
      "to": "telemetry",
      "y": 295,
      "label": "apply(ctx)：ctx.on('session/event', ...) 纯监听，不改结构",
      "variant": "security"
    },
    {
      "id": "runturn",
      "from": "script",
      "to": "loop",
      "y": 365,
      "label": "runTurn({ prompt })：agent.followup 唤醒 driver",
      "variant": "emphasis"
    },
    {
      "id": "append",
      "from": "loop",
      "to": "session",
      "y": 415,
      "label": "逐步 append：turn/start → step/start → assistant/chunk → step/end → turn/end"
    },
    {
      "id": "emit",
      "from": "session",
      "to": "telemetry",
      "y": 465,
      "label": "每次 append 触发 session/event，监听器逐条打印",
      "note": "副作用自行 try/catch：一个监听器抛错绝不能打断 agent 主循环"
    },
    {
      "id": "aggregate",
      "from": "loop",
      "to": "script",
      "y": 525,
      "label": "turn 收尾：聚合文本「观测到了这一次对话」，step 数 = 1",
      "variant": "return"
    }
  ],
  "activations": [
    { "participant": "harness", "from": 190, "to": 300, "type": "backend" },
    { "participant": "telemetry", "from": 290, "to": 470, "type": "security" },
    { "participant": "loop", "from": 360, "to": 530, "type": "messagebus" },
    { "participant": "session", "from": 410, "to": 470, "type": "database" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "两条事件面分工不同",
      "items": [
        "session/event 是持久事件流：turn/step/chunk 都在里面",
        "agent/* 是携带活 Agent 的策略事件，能影响下一步",
        "遥测、审计留痕、会话回放、进度 UI 都建在监听器上"
      ]
    },
    {
      "dot": "cyan",
      "title": "观察者纪律",
      "items": [
        "副作用必须 try/catch 包住",
        "监听器抛错不得打断主循环",
        "纯监听不改任何调用结构"
      ]
    },
    {
      "dot": "violet",
      "title": "这就是前端与协议驱动的骨架",
      "items": [
        "UI 从 session/event 渲染时间线",
        "用 agent.followup() / agent.steer() 把输入送回去",
        "本例 mock 一步收尾，step 数正好是 1"
      ]
    }
  ]
}
