  "cards": [
    {
      "dot": "emerald",
      "title": "换 provider 不换 Consumer",
      "items": [
        "run.ts 与 run-minimax.ts 共用 consume.ts",
        "差异只有 stream() 的 provider 入参",
        "输出结构与 mock 段逐项对齐"
      ]
    },
    {
      "dot": "cyan",
      "title": "双向翻译落在适配器里",
      "items": [
        "把 Anthropic SSE 事件翻回 StreamChunk 协议",
        "thinking 块映射成 reasoning-delta",
        "上层看不到端点差异"
      ]
    },
    {
      "dot": "violet",
      "title": "真实量不可复现，契约可复现",
      "items": [
        "回答文本、text-delta 条数、usage 每次都不同",
        "稳定的是四项协议检查与 chunk 类型集合",
