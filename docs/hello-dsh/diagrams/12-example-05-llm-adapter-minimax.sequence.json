    },
    {
      "id": "assert",
      "from": "consume",
      "to": "script",
      "y": 585,
      "label": "四项协议检查全为 true；契约被破坏就 fail loud",
      "variant": "emphasis"
    }
  ],
  "activations": [
    { "participant": "llm", "from": 190, "to": 360, "type": "messagebus" },
