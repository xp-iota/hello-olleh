    },
    {
      "participant": "session",
      "from": 720,
      "to": 775,
      "type": "database"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "四个入口，两个边界",
      "items": [
        "send 显式二选一，是底层全显式入口",
        "followup 进 nextTurn 且唤醒；steer 进 nextStep 且唤醒",
        "inject 进 nextStep 但不唤醒"
      ]
    },
    {
      "dot": "cyan",
      "title": "steer 与 followup 的分界",
      "items": [
        "两者都唤醒，差别只在落在哪条队列",
        "followup 落在下一轮，独占一个新 turn",
        "steer 落在本轮下一步，turn 不关闭"
      ]
    },
    {
      "dot": "violet",
      "title": "认领与关轮都发生在边界上",
      "items": [
        "主循环在每个 step 边界整体认领对应队列",
        "turn-stopping 派发后重读 inbox 决定是否关轮（见 09）",
        "agent/inbox/spliced 让入队与认领可回放"
      ]
    }
  ]
}