    {
      "dot": "cyan",
      "title": "为什么不直接用字符串",
      "items": [
        "target 是受控对象，携带 provider 侧的内部表示",
        "远端 provider 的真实路径与本地写法不同",
        "于是路径转换必须显式经过接口"
      ]
    },
    {
      "dot": "emerald",
      "title": "processPath 的用途",
      "items": [
        "把 target 转成能交给子进程的字符串",
        "沙箱或容器里的路径可能被重映射",
        "shell 与 subprocess 都依赖它"
      ]
    },
    {
      "dot": "rose",
      "title": "contains 是安全原语",
      "items": [
        "沙箱 provider 用它做路径边界校验",
        "避免通过相对路径逃出允许目录",
        "判定由 provider 实现，不在调用方"
      ]
    }
