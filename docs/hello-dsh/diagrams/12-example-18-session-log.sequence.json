{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "追加式会话日志：seq 连续性、surface 投影、replace 与 fork 边界",
    "output": "12-example-18-session-log.html",
    "viewBox": [1680, 800],
    "quality_profile": "showcase",
    "column_fit": "spread"
  },
  "participants": [
    { "id": "script", "type": "external", "label": "run.ts", "sublabel": "示例入口脚本" },
    { "id": "plugin", "type": "backend", "label": "session/event 监听", "sublabel": "18-session-log/index.ts" },
    { "id": "session", "type": "database", "label": "session", "sublabel": "追加式事件日志" },
    { "id": "surface", "type": "messagebus", "label": "surface 投影", "sublabel": "deriveMessages / surface.nodes" },
    { "id": "store", "type": "security", "label": "ctx.sessions", "sublabel": "SessionStore：fork / flush" }
  ],
  "segments": [
    { "from": 155, "to": 330, "label": "append 即广播" },
    { "from": 345, "to": 550, "label": "不变量与位置性替换" },
    { "from": 565, "to": 720, "label": "分叉与持久化检查点" }
  ],
  "messages": [
    {
      "id": "listen",
      "from": "script",
      "to": "plugin",
      "y": 195,
      "label": "createHarness() 后 loadPlugin：ctx.on('session/event') 逐条打印",
      "variant": "emphasis"
    },
    {
      "id": "runturn",
      "from": "script",
      "to": "session",
      "y": 245,
      "label": "① runTurn(...)：一个真实 turn 的 16 条事件顺序落日志",
      "variant": "emphasis"
    },
    {
      "id": "broadcast",
      "from": "session",
      "to": "plugin",
      "y": 295,
      "label": "每次 append 先落日志再广播：模型可见等于已落日志"
    },
    {
      "id": "invariant",
      "from": "script",
      "to": "session",
      "y": 365,
      "label": "②③ seq === 数组下标；改写已深冻结的事件抛 TypeError",
      "variant": "security"
    },
    {
      "id": "derive",
      "from": "script",
      "to": "surface",
      "y": 415,
      "label": "④ deriveMessages()：只投影 user/message、assistant/message、tool/result"
    },
    {
      "id": "replace",
      "from": "script",
      "to": "session",
      "y": 465,
      "label": "⑤ append(..., surfaceOp { op:'replace', start, end })",
      "variant": "emphasis",
      "note": "压缩就靠它：摘要占据被遮蔽区间的原位置，而不是追加到末尾"
    },
    {
      "id": "folded",
      "from": "surface",
      "to": "script",
      "y": 515,
      "label": "surface 节点 3 → 2，投影以摘要开头；两条 fail-closed 校验各自抛错",
      "variant": "return"
    },
    {
      "id": "fork",
      "from": "script",
      "to": "store",
      "y": 585,
      "label": "⑥ fork(session, boundary)：边界必须落在稳定前缀上",
      "variant": "emphasis"
    },
    {
      "id": "forkerr",
      "from": "store",
      "to": "session",
      "y": 635,
      "label": "切在未闭合 turn 内 → SessionForkError { code:'OPEN_TURN' }",
      "variant": "security",
      "note": "取 turn/end 之后的位置：boundary=16 时子会话继承 18 条事件"
    },
    {
      "id": "flush",
      "from": "script",
      "to": "store",
      "y": 685,
      "label": "⑦ flush(session)：parallel 派发 session/flush 检查点"
    }
  ],
  "activations": [
    { "participant": "plugin", "from": 190, "to": 300, "type": "backend" },
    { "participant": "session", "from": 240, "to": 640, "type": "database" },
    { "participant": "surface", "from": 410, "to": 520, "type": "messagebus" },
    { "participant": "store", "from": 580, "to": 690, "type": "security" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "模型可见等于已落日志",
      "items": [
        "会话是一条追加式事件日志",
        "turn / step 边界、消息、chunk、压缩、审批都是事件",
        "seq = log.length 是连续性契约，fork 与回放全靠它"
      ]
    },
    {
      "dot": "cyan",
      "title": "surface 只收三种事件",
      "items": [
        "user/message、assistant/message、tool/result",
        "deriveMessages 只投影它们，chunk 等裸事件不进",
        "surfaceOp append 直接入列，replace 先遮蔽区间"
      ]
    },
    {
      "dot": "violet",
      "title": "铸造与边界都 fail closed",
      "items": [
        "assistant/message 必须带 model 来源",
        "消息本体要用 createUserMessage / createAssistantMessage 铸造",
        "replace 区间要在 surface 上且引用完整，fork 不得切进未闭合 turn"
      ]
    }
  ]
}
