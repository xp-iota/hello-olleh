  "meta": {
    "title": "LLM 适配器（mock 路由）：注册 provider 到逐 chunk 消费的完整链路",
    "output": "12-example-05-llm-adapter-mock.html",
    "viewBox": [1680, 760],
    "quality_profile": "showcase",
    "column_fit": "spread"
  },
  "participants": [
    { "id": "script", "type": "external", "label": "run.ts", "sublabel": "示例入口脚本" },
    { "id": "harness", "type": "backend", "label": "createHarness", "sublabel": "runtime/harness.ts 装配层" },
    { "id": "adapter", "type": "backend", "label": "LlmAdapter 子类", "sublabel": "05-llm-adapter/index.ts" },
    { "id": "llm", "type": "messagebus", "label": "ctx.llm", "sublabel": "能力缝：Definition + Provider + Consumer" },
    { "id": "consume", "type": "security", "label": "consumeStream", "sublabel": "consume.ts 共享消费循环" }
  ],
  "segments": [
    { "from": 155, "to": 380, "label": "空出路由再补上适配器" },
    { "from": 395, "to": 600, "label": "同一 seam 上取流" },
    { "from": 615, "to": 680, "label": "协议硬约束核对" }
  ],
  "messages": [
    {
      "id": "harness",
      "from": "script",
      "to": "harness",
      "y": 195,
      "label": "createHarness({ mock: false })：不注册内置 mock 适配器",
      "variant": "emphasis",
      "note": "空出 mock 路由，好让插件自己占位；检测到 MINIMAX_API_KEY 时还会多注册一条真实路由"
    },
    {
      "id": "load",
      "from": "script",
      "to": "harness",
      "y": 245,
      "label": "loadPlugin(本插件)"
    },
    {
      "id": "apply",
      "from": "harness",
      "to": "adapter",
      "y": 295,
      "label": "apply(ctx)：实例化 LlmAdapter 子类"
    },
    {
      "id": "register",
      "from": "adapter",
      "to": "llm",
      "y": 345,
      "label": "registerAdapter(['mock'], adapter)：挂上一条模型路由",
      "variant": "security"
    },
    {
      "id": "list",
      "from": "script",
      "to": "llm",
      "y": 415,
      "label": "① listProviders() → [ 'minimax-m3', 'mock' ]"
    },
    {
      "id": "stream",
      "from": "script",
      "to": "llm",
      "y": 465,
      "label": "② stream({ provider: 'mock' })：经 llm/stream waterfall 派发（见 20）",
      "variant": "emphasis"
    },
    {
      "id": "dispatch",
      "from": "llm",
      "to": "adapter",
      "y": 515,
      "label": "命中 mock 路由 → adapter.stream(request, options)",
      "note": "stream() 是 LlmAdapter 唯一必需方法：换掉它等于换掉整个模型后端"
    },
    {
      "id": "chunks",
      "from": "adapter",
      "to": "consume",
      "y": 565,
      "label": "block-start → text-delta → block-end → usage → finish",
      "variant": "return"
    },
    {
      "id": "assert",
      "from": "consume",
      "to": "script",
      "y": 635,
      "label": "③ 聚合 assistant 文本 + 四项协议检查全为 true",
      "variant": "emphasis"
    }
  ],
  "activations": [
    { "participant": "harness", "from": 190, "to": 300, "type": "backend" },
    { "participant": "adapter", "from": 290, "to": 570, "type": "backend" },
    { "participant": "llm", "from": 340, "to": 520, "type": "messagebus" },
    { "participant": "consume", "from": 560, "to": 640, "type": "security" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "ctx.llm 是一条能力缝",
      "items": [
        "Definition + Provider + Consumer 三个角色分开",
        "stream() 是唯一必需方法",
        "换 provider 不动 agent-loop 一行代码"
      ]
    },
    {
      "dot": "cyan",
      "title": "协议硬约束由消费循环核对",
      "items": [
        "usage 必须在 finish 之前",
        "finish 之后不再发任何 chunk",
        "同一 block 的 delta 复用同一 index，并尊重 options.signal"
      ]
    },
    {
      "dot": "violet",
      "title": "路由是可插拔的",
      "items": [
        "createHarness({ mock: false }) 先空出 mock 路由",
        "插件用 registerAdapter(['mock']) 把它补上",
        "harness 检测到密钥会并存注册真实 minimax-m3 路由"
      ]
    }
  ]
}
