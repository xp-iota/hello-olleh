    },
    {
      "id": "exec",
      "from": "tools",
      "to": "tool",
      "y": 465,
      "label": "execute(args, exec) 运行"
    },
    {
      "id": "start",
      "from": "tool",
      "to": "subagents",
      "y": 515,
      "label": "ctx.subagents.start(...)：按名字取到 provider"
