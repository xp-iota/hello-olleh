    },
    {
      "id": "call-rm",
      "from": "script",
      "to": "tools",
      "y": 585,
      "label": "② callTool('bash', { cmd: 'rm -rf /' })",
      "variant": "emphasis"
    },
    {
      "id": "pre-rm",
      "from": "tools",
      "to": "pre",
      "y": 635,
      "label": "pre-execute 依旧 allow（明明放行了）"
    },
    {
      "id": "guard-rm",
      "from": "tools",
      "to": "guard",
      "y": 685,
      "label": "命中危险模式 'rm -rf' → 返回字符串即拒绝，终局",
      "variant": "security",
      "note": "没有任何 guard 或 pre-execute 监听者能强制放行已被拒的调用；bash 的 execute 从未被调用"
    }
  ],
  "activations": [
    { "participant": "guard", "from": 290, "to": 690, "type": "security" },
    { "participant": "tools", "from": 360, "to": 690, "type": "messagebus" },
    { "participant": "pre", "from": 410, "to": 640, "type": "backend" },
    { "participant": "tool", "from": 510, "to": 560, "type": "backend" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "guard 是单调最终拒绝",
      "items": [
        "运行位置在 tools/pre-execute 之后",
        "任一命中的 guard 都能拒绝这次调用",
        "没有谁能强制放行已被拒绝的调用"
      ]
    },
    {
      "dot": "cyan",
      "title": "返回值语义极简",
      "items": [
        "返回字符串即拒绝，字符串就是给人和模型的理由",
        "不置可否时不返回任何理由",
        "拒绝后工具的 execute 根本不会跑"
      ]
    },
    {
      "dot": "violet",
      "title": "与 03 的分工",
      "items": [
        "pre-execute 是可重排、可翻案的策略链",
        "guard 是绝不逾越的终局红线",
        "危险命令、越权路径这类硬约束放 guard"
      ]
    }
  ]
}
