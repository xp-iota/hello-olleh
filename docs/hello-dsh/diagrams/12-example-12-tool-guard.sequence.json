      "from": "script",
      "to": "pre",
      "y": 245,
      "label": "ctx.on('tools/pre-execute', 永远 allow)：用来证明 guard 的单调性"
    },
    {
      "id": "install-guard",
      "from": "script",
      "to": "guard",
