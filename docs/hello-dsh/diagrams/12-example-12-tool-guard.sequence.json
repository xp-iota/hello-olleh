    { "id": "guard", "type": "security", "label": "ctx.tools.guard", "sublabel": "12-tool-guard/index.ts" },
    { "id": "tools", "type": "messagebus", "label": "ctx.tools", "sublabel": "真实 ToolRuntime 工具管线" },
