    },
    {
      "id": "pre-ls",
      "from": "tools",
      "to": "pre",
      "y": 415,
      "label": "pre-execute waterfall 全部放行（可翻案策略链）"
    },
    {
      "id": "guard-ls",
      "from": "tools",
      "to": "guard",
      "y": 465,
      "label": "guard 检查在 pre-execute 之后：未命中，不给拒绝理由"
    },
    {
      "id": "exec-ls",
      "from": "tools",
      "to": "tool",
      "y": 515,
      "label": "execute → isError=false，bash 已执行 cmd=ls -la",
