  "cards": [
    {
      "dot": "emerald",
      "title": "父 agent 不等子 agent",
      "items": [
        "tool_result 只返回 subagent id 就立刻结束",
        "父 agent 的 turn 可以继续推进",
        "子 agent 的产出通过 inbox 异步汇入"
      ]
    },
    {
      "dot": "cyan",
      "title": "provider 是可替换的缝",
      "items": [
        "fork-in-process 只是其中一种实现",
        "同一套工具接口可以换成独立进程或远端",
        "subagent 服务负责选型，工具层不感知"
      ]
    },
    {
      "dot": "violet",
      "title": "三个工具各管一段",
      "items": [
        "tool-subagent 负责创建",
        "tool-subagent-report 负责子到父的回报",
        "tool-subagent-control 负责查状态与取消"
      ]
