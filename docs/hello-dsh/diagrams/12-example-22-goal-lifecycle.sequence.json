{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "目标生命周期：日志即状态，变更走乐观并发",
    "output": "12-example-22-goal-lifecycle.html",
    "viewBox": [1680, 760],
    "quality_profile": "showcase",
    "column_fit": "spread"
  },
  "participants": [
    { "id": "script", "type": "external", "label": "run.ts", "sublabel": "示例入口脚本" },
    { "id": "plugin", "type": "backend", "label": "goal 观察插件", "sublabel": "22-goal-lifecycle/index.ts" },
    { "id": "goals", "type": "messagebus", "label": "ctx.goals", "sublabel": "真实 GoalService（没有自己的存储）" },
    { "id": "session", "type": "database", "label": "session", "sublabel": "goal/change 事件日志" }
  ],
  "segments": [
    { "from": 155, "to": 330, "label": "创建并 arm" },
    { "from": 345, "to": 550, "label": "乐观并发下逐步推进" },
    { "from": 565, "to": 680, "label": "墓碑与回放" }
  ],
  "messages": [
    {
      "id": "install",
      "from": "script",
      "to": "plugin",
      "y": 195,
      "label": "createHarness({ plugins: [[本插件]] })：插件逐条打印 goal/change",
      "variant": "emphasis"
    },
    {
      "id": "create",
      "from": "script",
      "to": "goals",
      "y": 245,
      "label": "① create(agent, {...})：phase=active，activation=armed"
    },
    {
      "id": "append",
      "from": "goals",
      "to": "session",
      "y": 295,
      "label": "append goal/change：携带完整变更后状态，rev=1",
      "variant": "security",
      "note": "whole-value rule：事件带的是变更后全量状态，折叠就是 last-wins"
    },
    {
      "id": "pause",
      "from": "script",
      "to": "goals",
      "y": 365,
      "label": "② pause(agent, ref)：active → paused 并撤 arm"
    },
    {
      "id": "cas",
      "from": "script",
      "to": "goals",
      "y": 415,
      "label": "③ 用旧 ref 再操作 → GoalError：stale revision",
      "variant": "security"
    },
    {
      "id": "advance",
      "from": "script",
      "to": "goals",
      "y": 465,
      "label": "④⑤⑥ resume → block(reason) → complete：每步 rev+1",
      "variant": "emphasis"
    },
    {
      "id": "append2",
      "from": "goals",
      "to": "session",
      "y": 515,
      "label": "每次变更各 append 一条 goal/change"
    },
    {
      "id": "clear",
      "from": "script",
      "to": "goals",
      "y": 585,
      "label": "⑦ clear(agent, ref)：追加 null 墓碑，折叠结果回到未设置"
    },
    {
      "id": "replay",
      "from": "session",
      "to": "script",
      "y": 635,
      "label": "⑧ 日志即状态：回放 6 条 goal/change 即可重建全程",
      "variant": "return"
    }
  ],
  "activations": [
    { "participant": "plugin", "from": 190, "to": 300, "type": "backend" },
    { "participant": "goals", "from": 240, "to": 590, "type": "messagebus" },
    { "participant": "session", "from": 290, "to": 640, "type": "database" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "目标服务没有自己的存储",
      "items": [
        "状态只由所属会话日志折叠而来",
        "每次变更 append 一条携带完整状态的 goal/change",
        "折叠是 last-wins，clear 追加 null 墓碑"
      ]
    },
    {
      "dot": "cyan",
      "title": "变更走乐观并发",
      "items": [
        "必须带当前 GoalRef，即 { id, revision }",
        "revision 不匹配直接抛 GoalError",
        "phase 词表：active / paused / blocked / complete"
      ]
    },
    {
      "dot": "violet",
      "title": "activation 永不落日志",
      "items": [
        "armed 与 disarmed 是进程内状态",
        "重启后由授权恢复重建",
        "blocked 另外携带人机可读的 reason"
      ]
    }
  ]
}
