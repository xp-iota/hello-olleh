  "cards": [
    {
      "dot": "cyan",
      "title": "三者的依赖方向",
      "items": [
        "Provider 与 Consumer 都只依赖 Definition",
        "两者之间不互相 import",
        "因此换 Provider 不影响任何 Consumer"
      ]
    },
    {
      "dot": "emerald",
      "title": "Definition 里放什么",
      "items": [
        "接口方法签名",
        "capability 事件的类型定义",
        "不放任何具体实现或平台判断"
      ]
    },
    {
      "dot": "violet",
      "title": "为什么强制三角色",
      "items": [
        "少了 Definition 就无法替换实现",
        "少了多个 Provider 就证明不了可替换",
        "少了 Consumer 则能力对模型不可见"
      ]
    }
